# Konfigurasi Port Server Chatbot
PORT=3001

# Batasan Origin CORS (Origin website frontend Beranda)
ALLOWED_ORIGIN=http://localhost

# Kredensial Database MySQL Kampus (db_fasilitas_ikmi)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=db_fasilitas_ikmi

# API Key AI Provider (Opsional untuk pertanyaan non-lokal, jangan pernah simpan kredensial asli di example)
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
