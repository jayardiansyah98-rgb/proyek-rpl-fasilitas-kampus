# ============================================================
# Environment Configuration — Sistem Fasilitas STMIK IKMI Cirebon
# JANGAN commit file .env ke repository! Lihat .gitignore.
# Salin file ini menjadi .env dan isi nilainya.
# ============================================================

# ─── Fonnte WhatsApp API ─────────────────────────────────────
FONNTE_TOKEN=
FONNTE_API_URL=https://api.fonnte.com/send
FONNTE_TIMEOUT=15

# ─── SMTP Email ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Sistem Fasilitas IKMI

# ─── Toggle Notifikasi ───────────────────────────────────────
NOTIFICATION_ENABLED=true
WHATSAPP_NOTIFICATION_ENABLED=false
EMAIL_NOTIFICATION_ENABLED=false

# ─── Aplikasi ────────────────────────────────────────────────
APP_ENV=development
APP_URL=http://localhost/Fasilitas%20Kampus/public

